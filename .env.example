# Environment variables — copy to .env.local for local development
# VITE_REPLICA_URL: URL of the campus-replica app (default: local port 5174)
VITE_REPLICA_URL=http://127.0.0.1:5174/
# VITE_COPC_BASE_URL: Base URL serving the COPC file and generated JSON
#   Local default uses the bundled Vite survey middleware (/survey route)
#   For hosted deployment: set to a URL with CORS + byte-range (HTTP 206) support
#   Required files at that URL: cloud.copc.laz, manifest.json, route.json
# VITE_COPC_BASE_URL=https://your-blob-host.example.com/uod-survey
